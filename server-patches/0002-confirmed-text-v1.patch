+++ b/hermes_cli/web_confirmed_text.py
@@ -0,0 +1,171 @@
+"""Request and policy boundary for POST /api/fs/replace-text-v1."""
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+import re
+from pathlib import Path
+
+from fastapi import HTTPException
+
+import hermes_cli.confirmed_text as edit
+
+
+def _unique_object(items):
+    value = dict(items)
+    if len(items) != len(value):
+        raise ValueError('duplicate key')
+    return value
+
+
+def _absolute(raw):
+    path = Path(raw)
+    if (not raw.startswith('/') or raw.startswith('//') or '\\' in raw or '%' in raw
+            or raw.strip() != raw or str(path) != raw or '..' in path.parts
+            or any(ord(c) < 32 or ord(c) == 127 for c in raw)):
+        raise HTTPException(400, 'Expected a literal canonical absolute path')
+    return path
+
+
+async def handle(request, profile):
+    from hermes_cli.web_routers import files
+    files._require_token(request)
+    edit.require_host()
+    if (not profile or profile != profile.strip() or profile.casefold() == 'current'
+            or list(request.query_params.multi_items()) != [('profile', profile)]):
+        raise HTTPException(400, 'Exactly one explicit profile is required')
+    if request.headers.get('content-type', '').split(';', 1)[0].strip().lower() != 'application/json':
+        raise HTTPException(415, 'Expected application/json')
+    limit = files._FS_TEXT_PREVIEW_MAX_BYTES
+    raw = bytearray()
+    async for chunk in request.stream():
+        if len(raw) + len(chunk) > 6 * limit + 16384:
+            raise HTTPException(413, 'Request too large')
+        raw.extend(chunk)
+    try:
+        body = json.loads(raw.decode('utf-8'), object_pairs_hook=_unique_object)
+        if (type(body) is not dict or set(body) != {'session_id', 'cwd', 'path', 'expected_sha256', 'content'}
+                or not all(type(v) is str for v in body.values())):
+            raise ValueError()
+        for field in ('session_id', 'cwd', 'path', 'expected_sha256'):
+            if not body[field] or len(body[field].encode('utf-8')) > 4096:
+                raise ValueError()
+        if (not re.fullmatch('[0-9a-f]{64}', body['expected_sha256'])
+                or body['session_id'].strip() != body['session_id']):
+            raise ValueError()
+        data = body['content'].encode('utf-8')
+    except (ValueError, RecursionError) as exc:
+        raise HTTPException(400, 'Invalid confirmed-edit request') from exc
+    if len(data) > limit:
+        raise HTTPException(413, 'Text exceeds the preview limit')
+    if b'\0' in data or files._fs_looks_binary(data[:4096]):
+        raise HTTPException(415, 'Replacement is not text')
+    cwd, target = _absolute(body['cwd']), _absolute(body['path'])
+    if cwd.parent == cwd or cwd not in target.parents:
+        raise edit.refused()
+    return await asyncio.to_thread(_save, profile, body['session_id'], cwd, target,
+                                   body['expected_sha256'], data, limit)
+
+
+def _session(profile, session_id, cwd):
+    from gateway.session_policy import restore_policy
+    from hermes_constants import get_hermes_home
+    from hermes_cli.web_routers.sessions import _with_db
+    from persistence.core.errors import AuthorityRefusal
+
+    def exact(store):
+        # get_session_detail accepts prefixes. This write never resolves an alias/prefix.
+        row = store.sessions.get(session_id)
+
+        if (row is None or str(row.session_id) != session_id or row.cwd != str(cwd)
+                or row.profile_name not in (None, profile) or not row.chat_id):
+            raise edit.conflict()
+        try:
+            receipt = store.bindings.receipt(row.chat_id)
+            if (receipt.profile_id != str(get_hermes_home()) or receipt.session_id != row.chat_id
+                    or receipt.principal_id != row.user_id or receipt.route != row.session_key
+                    or receipt.current_target != session_id or store.bindings.validate_lineage(receipt) != session_id):
+                raise edit.conflict()
+            policy = restore_policy(receipt.policy)
+        except AuthorityRefusal as exc:
+            raise edit.refused() from exc
+        terminal = json.loads(policy.terminal_json)
+        if (policy.source not in ('gui', 'cli', 'tui') or policy.cwd != str(cwd)
+                or policy.safe_mode or policy.ignore_user_config or 'file' not in policy.toolsets
+                or terminal.get('TERMINAL_ENV') != 'local' or terminal.get('TERMINAL_CWD') != str(cwd)):
+            raise edit.refused()
+        return (receipt.session_id, row.started_at, row.runtime_generation, row.git_metadata_generation,
+                row.runtime_revision, receipt.principal_id, policy)
+
+    return _with_db(profile, exact, read_only=True)
+
+
+def _local_policy(home):
+    from hermes_constants import get_hermes_home, get_process_hermes_home
+    from tools.terminal_scope import build_profile_terminal_scope, enforce_no_refusal, get_terminal_scope
+    from tui_gateway.launch_profile_policy import _launch_env
+
+    if get_hermes_home().resolve(strict=True) != home:
+        raise edit.refused()
+    enforce_no_refusal()
+    bound = get_terminal_scope()
+    launch = home == get_process_hermes_home().resolve(strict=True)
+    overlay = _launch_env() if launch else None
+    live = build_profile_terminal_scope(home, env_overlay=overlay)
+    if (live.get('TERMINAL_ENV') != 'local' or (bound is not None and bound.get('TERMINAL_ENV') != 'local')
+            or (overlay is not None and overlay.get('TERMINAL_ENV', 'local') != 'local')):
+        raise edit.refused()
+
+
+def _task_local(session_id, cwd):
+    from tools.environments.local import LocalEnvironment
+    from tools.environments.sandbox_scope import hosted_scope
+    from tools.terminal_tool import resolve_task_overrides
+    from tools.terminal_tool_lifecycle import get_active_env
+
+    overrides = resolve_task_overrides(session_id)
+    active = get_active_env(session_id)  # lookup only; never construct/dial an environment
+    if (hosted_scope() is not None or (active is not None and type(active) is not LocalEnvironment)
+            or set(overrides) - {'cwd', 'cwd_source', 'workspace_key', 'env_type'}
+            or overrides.get('cwd', str(cwd)) != str(cwd) or overrides.get('env_type', 'local') != 'local'):
+        raise edit.refused()
+
+
+def _save(profile, session_id, cwd, target, expected, data, limit):
+    from agent.file_safety import get_read_block_error, get_write_denied_error, is_write_approval_required
+    from hermes_cli.web_routers import files
+    from hermes_cli.web_server_cron import _cron_profile_home
+    from tui_gateway.launch_profile_policy import profile_config_scope
+
+    canonical, home = _cron_profile_home(profile)  # includes the run-elsewhere refusal
+    if canonical != profile or home != home.resolve(strict=True):
+        raise edit.refused()
+    with profile_config_scope(home):
+        owner = _session(profile, session_id, cwd)
+        home_id = home.stat()
+
+        def authorize(scratch):
+            if (_cron_profile_home(profile) != (profile, home) or not os.path.samestat(home_id, home.stat())
+                    or _session(profile, session_id, cwd) != owner):
+                raise edit.conflict()
+            _local_policy(home)
+            _task_local(session_id, cwd)
+            logical_id = owner[0]
+            if logical_id != session_id:
+                _task_local(logical_id, cwd)
+            # Require the global hosted/locked-root policy AND the profile-specific guards.
+            # No staged-upload, container-mount, SSH, file: URL or decoding exceptions.
+            for path in (cwd, target):
+                if path.resolve(strict=False) != path:
+                    raise edit.refused()
+                files._hosted_fs_read_guard(path)
+                files._refuse_sensitive_write(path, str(path), cwd)
+            for path in (cwd, target, scratch):
+                if (get_read_block_error(str(path)) or get_write_denied_error(str(path), entry=True)
+                        or is_write_approval_required(str(path))):
+                    raise edit.refused()
+
+        # offline_file_access's lifecycle lock is held on this worker through *all* raw fd closes.
+        with files._serve_offline(target):
+            return edit.replace(cwd, target, expected, data, limit, files._fs_looks_binary, authorize)
