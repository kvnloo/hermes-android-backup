+def _fs_mark_git_ignored(target: Path, entries: list[dict[str, Any]]) -> None:
+    """Decorate only the admitted rows; an absent flag means unknown, never false."""
+    from hermes_cli._subprocess_compat import NO_LAZY_FETCH_ENV, noninteractive_repo_git_env
+
+    if not entries or len(entries) > 512:
+        return
+    try:
+        # check-ignore rejects --literal-pathspecs. './' neutralizes leading ':';
+        # don't submit wildmatch characters, which can match unrelated index entries.
+        rows = {b"./" + os.fsencode(e["name"]): e for e in entries
+                if not any(c in e["name"] for c in "*?[\\")}
+        names = b"".join(name + b"\0" for name in rows)
+        if not names or len(names) > 32 * 1024:
+            return
+        env = noninteractive_repo_git_env(target)
+        if env is None:
+            return
+        proc = subprocess.run(
+            ["git", "-c", f"core.excludesFile={os.devnull}", "check-ignore", "--stdin", "-z"],
+            cwd=target, input=names, capture_output=True, timeout=2, creationflags=windows_hide_flags(),
+            env={**env, **NO_LAZY_FETCH_ENV, "GIT_OPTIONAL_LOCKS": "0", "GIT_ALLOW_PROTOCOL": ""},
+        )
+    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError):
+        return
+    # 1 means *no matches*, not a spawn failure. A warning (e.g. unreadable
+    # ignore file), malformed output or any other exit makes the batch unknown.
+    if proc.stderr or proc.returncode not in (0, 1):
+        return
+    records = proc.stdout.split(b"\0")
+    ignored = set(records[:-1])
+    if records[-1] or (proc.returncode == 0) != bool(ignored) or not ignored.issubset(rows):
+        return
+    for name, row in rows.items():
+        row["gitIgnored"] = name in ignored
